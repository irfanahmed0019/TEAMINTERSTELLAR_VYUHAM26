{
  "name": "buildmylogic",
  "publisher": "buildmylogic",
  "displayName": "BuildMyLogic",
  "description": "BuildMyLogic in VS Code: get a task from the website, write code, run tests and submit. Your submissions feed your Struggle DNA.",
  "version": "0.4.2",
  "files": [
    "dist/extension.js",
    "media/**",
    "package.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:buildMyLogic.sidebar",
    "onUri",
    "onView:buildMyLogic.results"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "BuildMyLogic",
      "properties": {
        "buildMyLogic.apiBaseUrl": {
          "type": "string",
          "default": "https://buildmylogicxyz.vercel.app",
          "description": "BuildMyLogic API base URL. Use http://localhost:8080 for a local web server. This contains no secret."
        },
        "buildMyLogic.session": {
          "type": "object",
          "default": {},
          "scope": "window",
          "description": "Stored active BuildMyLogic Session ID for the connected learning session."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "buildMyLogic",
          "title": "BuildMyLogic",
          "icon": "media/buildMyLogic.svg"
        }
      ],
      "panel": [
        {
          "id": "buildMyLogicResults",
          "title": "BuildMyLogic",
          "icon": "media/buildMyLogic.svg"
        }
      ]
    },
    "views": {
      "buildMyLogic": [
        {
          "type": "webview",
          "id": "buildMyLogic.sidebar",
          "name": "BuildMyLogic"
        }
      ],
      "buildMyLogicResults": [
        {
          "type": "webview",
          "id": "buildMyLogic.results",
          "name": "BuildMyLogic Results"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "package": "node esbuild.js --production",
    "test": "node --experimental-strip-types --test src/ui-contract.test.mjs src/project-evaluator.test.mjs src/literal-repair.test.mjs src/pairing-code.test.mjs src/practice-variety.test.mjs src/no-tracking.test.mjs"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Local commands and source submissions require a trusted workspace."
    }
  }
}
